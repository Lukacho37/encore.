# Copie ce fichier en .env et adapte les valeurs.

# Port HTTP du serveur
PORT=3000
# Adresse publique du site : sert à construire les liens des e-mails (vérification, mot de passe)
# En développement avec `npm run dev`, garde http://localhost:5173
APP_URL=http://localhost:5173
# Fichier de la base SQLite (garde-le sur un disque persistant en production)
DATABASE_FILE=data/albummania.db
# Derrière un reverse proxy (Render, Railway, Nginx…), mets true pour récupérer la vraie IP des joueurs
TRUST_PROXY=false

# Accès admin : mets ICI TON adresse e-mail (celle de ton compte AlbumMania, une fois vérifiée).
# C'est le seul moyen d'être admin : personne d'autre ne peut le devenir, même en modifiant la base.
ADMIN_EMAILS=

# Envoi des e-mails (SMTP). Sans SMTP_HOST, les e-mails arrivent dans la boîte de test /dev/mailbox.
# Exemples : Brevo (smtp-relay.brevo.com:587), Resend (smtp.resend.com:465, SMTP_SECURE=true), Mailgun, OVH…
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="AlbumMania <no-reply@ton-domaine.fr>"

# Boosters gratuits : un toutes les N minutes, stock maximum
PACK_REGEN_MINUTES=30
PACK_MAX_STOCK=5

# Vraies pochettes et liens d'écoute : "auto" ou "deezer" (pochettes de Deezer), "off" (visuels générés).
# Les images restent hébergées par Deezer, jamais copiées. L'API Web de Spotify n'est pas utilisée (ses conditions
# interdisent les jeux) : il n'y a pas de clés Spotify à fournir.
COVERS=auto
COVERS_MARKET=FR
# Vraies pochettes dans les images à partager (« Mes 9 albums »…), composées dans le navigateur du joueur.
# "off" les remplace par les visuels générés AlbumMania.
SHARE_COVERS=deezer

# Mentions légales (/legal/mentions, obligatoires en France) : remplis-les avant la mise en ligne.
LEGAL_EDITOR_NAME=
LEGAL_EDITOR_ADDRESS=
LEGAL_EDITOR_EMAIL=
LEGAL_PUBLICATION_DIRECTOR=
LEGAL_HOST_NAME=
LEGAL_HOST_ADDRESS=
LEGAL_HOST_PHONE=
# Contact pour les signalements et les données personnelles (par défaut : LEGAL_EDITOR_EMAIL)
LEGAL_CONTACT_EMAIL=
# Version (date) des CGU en vigueur : la changer demande aux comptes existants d'accepter la nouvelle version
TERMS_VERSION=
TERMS_UPDATED_AT=

# Boîte e-mail de test (/dev/mailbox) : seulement en local (le serveur refuse de démarrer avec une adresse publique)
# DEV_MAILBOX=1

# Catalogue : au démarrage, le serveur importe automatiquement des albums depuis l'API publique de Deezer
# (albums studio des artistes les plus écoutés, dans tous les genres) jusqu'à CATALOG_TARGET albums.
# Compte environ 3 heures pour 20 000 albums ; le jeu reste jouable pendant l'import, qui reprend après un redémarrage
# (et 10 minutes après une panne de Deezer). Ensuite, une fois par jour, les nouveaux albums des artistes déjà importés
# entrent au catalogue. La pause demandée dans l'espace admin tient jusqu'au bouton « Lancer ».
# "deezer" (par défaut) ou "off" (seulement les 20 albums de base) ; toute autre valeur coupe aussi l'import.
CATALOG_IMPORT=deezer
CATALOG_TARGET=20000
# Filtres : artistes avec au moins N fans Deezer, albums avec au moins N fans, au plus N albums par artiste.
CATALOG_MIN_ARTIST_FANS=15000
CATALOG_MIN_ALBUM_FANS=500
CATALOG_MAX_ALBUMS_PER_ARTIST=10
