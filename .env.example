# Copie ce fichier en .env et adapte les valeurs.

# Port HTTP du serveur
PORT=3000
# Adresse publique du site : sert à construire les liens des e-mails (vérification, mot de passe)
# En développement avec `npm run dev`, garde http://localhost:5173
APP_URL=http://localhost:5173
# Fichier de la base SQLite (garde-le sur un disque persistant en production)
DATABASE_FILE=data/albummania.db
# Derrière un reverse proxy (Render, Railway, Nginx…), mets true pour récupérer la vraie IP des joueurs
TRUST_PROXY=false

# Accès admin : mets ICI TON adresse e-mail (celle de ton compte AlbumMania, une fois vérifiée).
# C'est le seul moyen d'être admin : personne d'autre ne peut le devenir, même en modifiant la base.
ADMIN_EMAILS=

# Envoi des e-mails (SMTP). Sans SMTP_HOST, les e-mails arrivent dans la boîte de test /dev/mailbox.
# Exemples : Brevo (smtp-relay.brevo.com:587), Resend (smtp.resend.com:465, SMTP_SECURE=true), Mailgun, OVH…
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="AlbumMania <no-reply@ton-domaine.fr>"

# Boosters gratuits : un toutes les N minutes, stock maximum
PACK_REGEN_MINUTES=30
PACK_MAX_STOCK=5

# Blind test : "off" (mode indices) ou "itunes" (extraits de 30 s via l'API iTunes Search).
# Les conditions d'Apple réservent ces extraits à la promotion de l'iTunes Store et interdisent leur usage
# dans un jeu : laisse "off" sauf autorisation écrite d'Apple.
BLINDTEST_AUDIO=off
PREVIEW_COUNTRY=FR

# Vraies pochettes et liens d'écoute : "auto" (Spotify si les clés sont renseignées, sinon Deezer),
# "spotify", "deezer" ou "off" (visuels générés). Les images restent hébergées par la plateforme.
COVERS=auto
COVERS_MARKET=FR
# Clés d'une application Spotify (developer.spotify.com/dashboard), facultatives.
# Spotify exige un abonnement Premium actif pour le propriétaire de l'application.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Catalogue : au démarrage, le serveur importe automatiquement des albums depuis l'API publique de Deezer
# (albums studio des artistes les plus écoutés, dans tous les genres) jusqu'à CATALOG_TARGET albums.
# Compte environ 3 heures pour 20 000 albums ; le jeu reste jouable pendant l'import, qui reprend après un redémarrage
# et vérifie une fois par jour les nouvelles sorties. "off" : seulement les 20 albums de base.
CATALOG_IMPORT=deezer
CATALOG_TARGET=20000
# Filtres : artistes avec au moins N fans Deezer, albums avec au moins N fans, au plus N albums par artiste.
CATALOG_MIN_ARTIST_FANS=15000
CATALOG_MIN_ALBUM_FANS=500
CATALOG_MAX_ALBUMS_PER_ARTIST=10
